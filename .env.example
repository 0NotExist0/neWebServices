# Google Drive API Configuration
# 1. Crea una API Key su Google Cloud Console (https://console.cloud.google.com/)
# 2. Abilita l'API "Google Drive API" nel progetto
# 3. Condividi la cartella su Drive come "Chiunque abbia il link può visualizzare"
# 4. Inserisci qui la chiave e l'ID della cartella principale (visibile nell'URL del Drive)

GOOGLE_DRIVE_API_KEY=
NEXT_PUBLIC_GOOGLE_DRIVE_API_KEY=
NEXT_PUBLIC_GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Configurazione Negozio
NEXT_PUBLIC_STORE_NAME="Maison Chic Boutique"
NEXT_PUBLIC_STORE_TAGLINE="Collezione Esclusiva & Prêt-à-Porter"
NEXT_PUBLIC_WHATSAPP_NUMBER="+393400000000"
NEXT_PUBLIC_CURRENCY="€"
